# Copiez ce fichier en .env.local puis renseignez vos clés.

# Clé secrète Stripe (tableau de bord Stripe > Développeurs > Clés API).
# Utilisez une clé qui commence par sk_test_ pour les essais.
STRIPE_SECRET_KEY=

# Secret de signature du webhook (affiché par « stripe listen » ou dans le tableau de bord).
# Facultatif en local : la page de confirmation vérifie déjà le paiement auprès de Stripe.
STRIPE_WEBHOOK_SECRET=

# Adresse publique du site, utilisée pour les retours de Stripe.
# Facultatif en local : déduite de l'en-tête Host si vide.
NEXT_PUBLIC_SITE_URL=
